datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  CASHIER
  CLIENT
}

enum MovementType {
  COMPRA
  VENTA_POS
  VENTA_WEB
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum PaymentMethodType {
  CASH
  QR_TRANSFER
  CARD
}

enum ArqueoStatus {
  CUADRADO
  SOBRANTE
  FALTANTE
}

model Tenant {
  id           String   @id @default(uuid()) @db.Uuid
  businessName String   @map("business_name") @db.VarChar(150)
  nitRut       String?  @map("nit_rut") @db.VarChar(50)
  currency     String   @default("BOB") @db.VarChar(10)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  users           User[]
  categories      Category[]
  products        Product[]
  productVariants ProductVariant[]
  purchaseOrders  PurchaseOrder[]
  inventoryKardex InventoryKardex[]
  cashShifts      CashShift[]
  sales           Sale[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String   @db.VarChar(120)
  email        String   @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole @default(CASHIER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  purchaseOrders PurchaseOrder[]
  cashShifts     CashShift[]
  sales          Sale[]

  @@unique([tenantId, email], name: "uq_users_tenant_email")
  @@map("users")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String   @db.VarChar(100)
  slug      String   @db.VarChar(120)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]

  @@unique([tenantId, slug], name: "uq_categories_tenant_slug")
  @@map("categories")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  name        String   @db.VarChar(150)
  brand       String?  @default("Genérica") @db.VarChar(100)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  category Category         @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]

  @@map("products")
}

model ProductVariant {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  sku               String   @db.VarChar(60)
  barcode           String?  @db.VarChar(60)
  color             String   @db.VarChar(60)
  sizeOrModel       String   @map("size_or_model") @db.VarChar(60)
  salePrice         Decimal  @map("sale_price") @db.Decimal(12, 2)
  currentUnitCost   Decimal  @default(0.00) @map("current_unit_cost") @db.Decimal(12, 2)
  currentStock      Int      @default(0) @map("current_stock")
  minStockThreshold Int      @default(3) @map("min_stock_threshold")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseOrderItems PurchaseOrderItem[]
  kardexMovements    InventoryKardex[]
  saleItems          SaleItem[]

  @@unique([tenantId, sku], name: "uq_variants_tenant_sku")
  @@map("product_variants")
}

model PurchaseOrder {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  supplierName String?  @default("Proveedor Local") @map("supplier_name") @db.VarChar(150)
  totalAmount  Decimal  @map("total_amount") @db.Decimal(12, 2)
  userId       String   @map("user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant              @relation(fields: [tenantId], references: [id])
  user   User                @relation(fields: [userId], references: [id])
  items  PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(uuid()) @db.Uuid
  purchaseOrderId String  @map("purchase_order_id") @db.Uuid
  variantId       String  @map("variant_id") @db.Uuid
  quantity        Int
  unitCost        Decimal @map("unit_cost") @db.Decimal(12, 2)
  subtotal        Decimal @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id])

  @@map("purchase_order_items")
}

model InventoryKardex {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  variantId     String       @map("variant_id") @db.Uuid
  movementType  MovementType @map("movement_type")
  quantity      Int
  previousStock Int          @map("previous_stock")
  newStock      Int          @map("new_stock")
  unitCost      Decimal      @map("unit_cost") @db.Decimal(12, 2)
  referenceId   String?      @map("reference_id") @db.VarChar(100)
  userId        String       @map("user_id") @db.VarChar(100)
  notes         String?      @db.Text
  createdAt     DateTime     @default(now()) @map("created_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("inventory_kardex")
}

model CashShift {
  id                   String        @id @default(uuid()) @db.Uuid
  tenantId             String        @map("tenant_id") @db.Uuid
  cashierId            String        @map("cashier_id") @db.Uuid
  initialAmount        Decimal       @map("initial_amount") @db.Decimal(12, 2)
  totalCashSales       Decimal       @default(0.00) @map("total_cash_sales") @db.Decimal(12, 2)
  totalDigitalSales    Decimal       @default(0.00) @map("total_digital_sales") @db.Decimal(12, 2)
  manualIncome         Decimal       @default(0.00) @map("manual_income") @db.Decimal(12, 2)
  manualExpenses       Decimal       @default(0.00) @map("manual_expenses") @db.Decimal(12, 2)
  theoreticalAmount    Decimal?      @map("theoretical_amount") @db.Decimal(12, 2)
  declaredPhysicalCash Decimal?      @map("declared_physical_cash") @db.Decimal(12, 2)
  difference           Decimal?      @db.Decimal(12, 2)
  arqueoResult         ArqueoStatus? @map("arqueo_result")
  status               ShiftStatus   @default(OPEN)
  openedAt             DateTime      @default(now()) @map("opened_at")
  closedAt             DateTime?     @map("closed_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  cashier User    @relation(fields: [cashierId], references: [id])
  sales   Sale[]

  @@map("cash_shifts")
}

model Sale {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  cashShiftId    String?  @map("cash_shift_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  customerName   String?  @default("Cliente Mostrador") @map("customer_name") @db.VarChar(150)
  totalAmount    Decimal  @map("total_amount") @db.Decimal(12, 2)
  discountAmount Decimal  @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  cashShift CashShift?    @relation(fields: [cashShiftId], references: [id])
  user      User          @relation(fields: [userId], references: [id])
  items     SaleItem[]
  payments  SalePayment[]

  @@map("sales")
}

model SaleItem {
  id        String  @id @default(uuid()) @db.Uuid
  saleId    String  @map("sale_id") @db.Uuid
  variantId String  @map("variant_id") @db.Uuid
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  unitCost  Decimal @map("unit_cost") @db.Decimal(12, 2)
  discount  Decimal @default(0.00) @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  sale    Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("sale_items")
}

model SalePayment {
  id            String            @id @default(uuid()) @db.Uuid
  saleId        String            @map("sale_id") @db.Uuid
  paymentMethod PaymentMethodType @map("payment_method")
  amountPaid    Decimal           @map("amount_paid") @db.Decimal(12, 2)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("sale_payments")
}
